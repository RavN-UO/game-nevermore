{
  "name": "nevermore",
  "version": "0.1.0",
  "description": "NEVERMORE — a one-thumb gothic arcade game. Guide a raven through an endless abyss.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs"
  },
  "keywords": [
    "phaser",
    "game",
    "arcade",
    "pwa",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "phaser": "^3.88.2",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.21.1"
  }
}
